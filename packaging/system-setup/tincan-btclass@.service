[Unit]
Description=Set Bluetooth adapter %I Class of Device to hands-free for Tincan
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=oneshot
# Only adapter names (hciN) are accepted, never connection devices like hci0:51.
# BlueZ's hostname plugin can rewrite the class briefly after startup; retry a few times.
ExecStart=/bin/sh -c 'case "$1" in hci[0-9]|hci[0-9][0-9]|hci[0-9][0-9][0-9]) ;; *) exit 2;; esac; for i in 1 2 3 4 5; do btmgmt --index "$1" class 4 8 && exit 0; sleep 1; done; exit 1' -- %i
